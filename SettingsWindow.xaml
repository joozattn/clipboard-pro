<Window x:Class="ClipboardPro.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="剪贴板设置"
        Width="480" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.26" Color="#000000" />
        </Border.Effect>

        <Border Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="10">
            <StackPanel Margin="22,18,22,16">

                <!-- 标题栏（可拖动） -->
                <Grid Margin="0,0,0,16"
                      Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <TextBlock Text="剪贴板设置"
                               Style="{StaticResource BaseText}"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource IconButtonStyle}"
                            Click="Close_Click">
                        <Path Width="10" Height="10"
                              Stretch="Uniform"
                              Stroke="{DynamicResource TextSecondary}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M1,1 L8,8 M8,1 L1,8" />
                    </Button>
                </Grid>

                <Separator Background="{DynamicResource Divider}" Height="1" Margin="0,0,0,16" />

                <!-- 保存条数 -->
                <TextBlock Text="历史记录保存条数"
                           Style="{StaticResource BaseText}"
                           FontSize="13"
                           FontWeight="SemiBold" />
                <TextBlock Text="超出后自动删除最旧的未固定条目。已固定的条目不受此限制，也不会被删除。"
                           Style="{StaticResource BaseText}"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,10" />

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Slider x:Name="MaxEntriesSlider"
                            Grid.Column="0"
                            Minimum="0" Maximum="5000"
                            TickFrequency="50"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            ValueChanged="MaxEntriesSlider_ValueChanged" />

                    <TextBox Grid.Column="1"
                             x:Name="MaxEntriesBox"
                             Width="76"
                             Margin="12,0,0,0"
                             Style="{StaticResource SearchBoxStyle}"
                             TextAlignment="Right"
                             VerticalContentAlignment="Center"
                             LostFocus="MaxEntriesBox_LostFocus"
                             KeyDown="MaxEntriesBox_KeyDown" />
                </Grid>

                <TextBlock x:Name="MaxEntriesHint"
                           Style="{StaticResource BaseText}"
                           FontSize="11"
                           Foreground="{DynamicResource TextTertiary}"
                           Margin="0,2,0,18" />

                <Separator Background="{DynamicResource Divider}" Height="1" Margin="0,0,0,16" />

                <!-- 开关项 -->
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="开机自动启动"
                                       Style="{StaticResource BaseText}"
                                       FontSize="13" />
                            <TextBlock Text="登录 Windows 后自动在后台运行"
                                       Style="{StaticResource BaseText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextTertiary}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  x:Name="StartupCheck"
                                  VerticalAlignment="Center"
                                  Click="StartupCheck_Click" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="选中后自动粘贴"
                                       Style="{StaticResource BaseText}"
                                       FontSize="13" />
                            <TextBlock Text="点击条目后直接粘贴到之前的窗口；关闭则仅复制到剪贴板"
                                       Style="{StaticResource BaseText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextTertiary}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  x:Name="PasteCheck"
                                  VerticalAlignment="Center"
                                  Click="PasteCheck_Click" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="接管 Win+V"
                                       Style="{StaticResource BaseText}"
                                       FontSize="13" />
                            <TextBlock Text="屏蔽系统自带的剪贴板面板，把 Win+V 交给本应用唤起"
                                       Style="{StaticResource BaseText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextTertiary}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  x:Name="InterceptWinVCheck"
                                  VerticalAlignment="Center"
                                  Click="InterceptWinVCheck_Click" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="显示托盘图标"
                                       Style="{StaticResource BaseText}"
                                       FontSize="13" />
                            <TextBlock Text="关闭后不再显示托盘图标，仍可通过面板右上角的设置入口进入设置"
                                       Style="{StaticResource BaseText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextTertiary}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  x:Name="ShowTrayIconCheck"
                                  VerticalAlignment="Center"
                                  Click="ShowTrayIconCheck_Click" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="开机时提示"
                                       Style="{StaticResource BaseText}"
                                       FontSize="13" />
                            <TextBlock Text="托盘图标关闭时，开机自启后弹一次提示，确认程序已在后台运行"
                                       Style="{StaticResource BaseText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextTertiary}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  x:Name="StartupNotifyCheck"
                                  VerticalAlignment="Center"
                                  Click="StartupNotifyCheck_Click" />
                    </Grid>
                </StackPanel>

                <Separator Background="{DynamicResource Divider}" Height="1" Margin="0,0,0,16" />

                <!-- 主题 -->
                <TextBlock Text="外观主题"
                           Style="{StaticResource BaseText}"
                           FontSize="13"
                           Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <RadioButton x:Name="ThemeAuto" Content="跟随系统" GroupName="theme"
                                 Foreground="{DynamicResource TextPrimary}"
                                 FontFamily="Microsoft YaHei UI, Segoe UI"
                                 FontSize="12.5"
                                 Margin="0,0,18,0"
                                 Click="Theme_Changed" />
                    <RadioButton x:Name="ThemeLight" Content="浅色" GroupName="theme"
                                 Foreground="{DynamicResource TextPrimary}"
                                 FontFamily="Microsoft YaHei UI, Segoe UI"
                                 FontSize="12.5"
                                 Margin="0,0,18,0"
                                 Click="Theme_Changed" />
                    <RadioButton x:Name="ThemeDark" Content="深色" GroupName="theme"
                                 Foreground="{DynamicResource TextPrimary}"
                                 FontFamily="Microsoft YaHei UI, Segoe UI"
                                 FontSize="12.5"
                                 Click="Theme_Changed" />
                </StackPanel>

                <Separator Background="{DynamicResource Divider}" Height="1" Margin="0,0,0,16" />

                <!-- 数据位置与操作 -->
                <TextBlock Text="数据位置"
                           Style="{StaticResource BaseText}"
                           FontSize="13"
                           Margin="0,0,0,6" />
                <TextBlock x:Name="DataPathText"
                           Style="{StaticResource BaseText}"
                           FontSize="11"
                           Foreground="{DynamicResource TextTertiary}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource TextButtonStyle}"
                            Content="打开数据文件夹"
                            Click="OpenDataFolder_Click" />
                    <Button Style="{StaticResource TextButtonStyle}"
                            Content="更改位置…"
                            Margin="8,0,0,0"
                            Click="ChangeDataDir_Click" />
                    <Button Style="{StaticResource TextButtonStyle}"
                            Content="清空全部记录"
                            Margin="8,0,0,0"
                            Click="ClearAll_Click" />
                </StackPanel>

                <Button Style="{StaticResource TextButtonStyle}"
                        Content="创建桌面快捷方式"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,0"
                        Click="CreateShortcut_Click" />

                <Separator Background="{DynamicResource Divider}" Height="1" Margin="0,16,0,14" />

                <!-- 底部按钮 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SaveButton"
                            Style="{StaticResource TextButtonStyle}"
                            Content="保存"
                            Padding="18,7"
                            Foreground="{DynamicResource Accent}"
                            Click="Save_Click" />
                    <Button Style="{StaticResource TextButtonStyle}"
                            Content="关闭"
                            Padding="18,7"
                            Margin="8,0,0,0"
                            Click="Close_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</Window>