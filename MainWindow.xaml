<Window x:Class="ClipboardPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ClipboardPro.Models"
        Title="剪贴板"
        Width="388" Height="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- 外层留白用于承载投影 -->
    <Border Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.22" Color="#000000" />
        </Border.Effect>

        <Border Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="8"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ===== 顶部：左侧空白可拖动窗口，右侧 设置/固定/关闭 ===== -->
                <Grid Grid.Row="0" Margin="10,8,10,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 拖动区：按住空白处即可拖动面板到任意位置 -->
                    <Border Grid.Column="0"
                            Background="Transparent"
                            Cursor="SizeAll"
                            ToolTip="按住拖动可移动面板位置"
                            MouseLeftButtonDown="DragArea_MouseLeftButtonDown" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButtonStyle}"
                                Width="30" Height="30"
                                ToolTip="设置"
                                Click="SettingsButton_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                       Text="&#xE713;"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </Button>

                        <Button x:Name="PinPanelButton"
                                Style="{StaticResource IconButtonStyle}"
                                Width="30" Height="30"
                                ToolTip="窗口置顶（开启后始终显示在最前面）"
                                Click="PinPanelButton_Click">
                            <Path x:Name="PinPanelGlyph"
                                  Width="12" Height="12"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1.4"
                                  StrokeLineJoin="Round"
                                  Data="M8,1.5 L8,1.5 M5.5,1.5 L10.5,1.5 L10.5,3.2 L9.5,4.6 L9.5,6.8 L11,8 L11,9 L5,9 L5,8 L6.5,6.8 L6.5,4.6 L5.5,3.2 Z M8,9 L8,14" />
                        </Button>

                        <Button Style="{StaticResource IconButtonStyle}"
                                Width="30" Height="30"
                                ToolTip="关闭"
                                Click="ClosePanelButton_Click">
                            <Path Width="10" Height="10"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M1,1 L8,8 M8,1 L1,8" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ===== 内容标题行：剪贴板 + 全部清除 ===== -->
                <Grid Grid.Row="1" Margin="16,6,16,8">
                    <TextBlock Text="剪贴板"
                               Style="{StaticResource BaseText}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />

                    <Button x:Name="ClearAllButton"
                            Style="{StaticResource OutlineButtonStyle}"
                            Content="全部清除"
                            HorizontalAlignment="Right"
                            Click="ClearAllButton_Click" />
                </Grid>

                <!-- ===== 条目列表 ===== -->
                <Grid Grid.Row="2">
                    <ScrollViewer x:Name="ItemsScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="8,0,8,8"
                                  CanContentScroll="False"
                                  Focusable="False">
                        <ItemsControl x:Name="ItemsHost">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ClipItem}">
                                    <Border Style="{StaticResource ClipCardStyle}"
                                            x:Name="Card"
                                            MouseEnter="Card_MouseEnter"
                                            MouseLeave="Card_MouseLeave"
                                            MouseLeftButtonUp="Card_MouseLeftButtonUp">
                                        <Border.ContextMenu>
                                            <ContextMenu Style="{StaticResource ClipContextMenuStyle}">
                                                <MenuItem Style="{StaticResource ClipMenuItemStyle}"
                                                          Header="固定"
                                                          Tag="pin"
                                                          Click="MenuPin_Click" />
                                                <MenuItem Style="{StaticResource ClipMenuItemStyle}"
                                                          Header="取消固定"
                                                          Tag="unpin"
                                                          Click="MenuPin_Click" />
                                                <MenuItem Style="{StaticResource ClipMenuItemStyle}"
                                                          Header="删除"
                                                          Tag="delete"
                                                          Click="MenuDelete_Click" />
                                            </ContextMenu>
                                        </Border.ContextMenu>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 内容：垂直居中，高度随内容自适应 -->
                                            <Grid Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock x:Name="TextPreview"
                                                           Style="{StaticResource BaseText}"
                                                           FontSize="13.5"
                                                           LineHeight="20"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxHeight="40"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Preview}" />

                                                <Image x:Name="ImagePreview"
                                                       Source="{Binding BlobFile, Converter={StaticResource BlobToImage}}"
                                                       Stretch="Uniform"
                                                       StretchDirection="DownOnly"
                                                       MaxHeight="64"
                                                       MaxWidth="220"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       Visibility="Collapsed"
                                                       SnapsToDevicePixels="True" />
                                            </Grid>

                                            <!-- 操作按钮：右侧竖排，永不重叠 -->
                                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                                <Button Style="{StaticResource IconButtonStyle}"
                                                        Width="26" Height="26"
                                                        Background="{DynamicResource HoverOverlay}"
                                                        ToolTip="更多操作"
                                                        Click="MoreButton_Click">
                                                    <Path Width="12" Height="3"
                                                          Stretch="Fill"
                                                          Fill="{DynamicResource TextSecondary}"
                                                          Data="M0,0 A1.5,1.5 0 1 1 0,0.01 Z M4.5,0 A1.5,1.5 0 1 1 4.51,0.01 Z M9,0 A1.5,1.5 0 1 1 9.01,0.01 Z" />
                                                </Button>

                                                <Button Style="{StaticResource IconButtonStyle}"
                                                        Width="24" Height="24"
                                                        Margin="1,2,1,0"
                                                        Tag="pin"
                                                        ToolTip="固定"
                                                        Click="PinButton_Click">
                                                    <Path x:Name="PinGlyph"
                                                          Width="11" Height="11"
                                                          Stretch="Uniform"
                                                          Stroke="{DynamicResource TextTertiary}"
                                                          StrokeThickness="1.3"
                                                          StrokeLineJoin="Round"
                                                          Data="M6,1 L6,1 M3,1 L9,1 L9,3 L8,5 L8,7 L4,7 L4,5 L3,3 Z M6,7 L6,11" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsImage}" Value="True">
                                            <Setter TargetName="ImagePreview" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="TextPreview" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Pinned}" Value="True">
                                            <Setter TargetName="PinGlyph" Property="Stroke" Value="{DynamicResource PinGlyph}" />
                                            <Setter TargetName="PinGlyph" Property="Opacity" Value="1" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Pinned}" Value="False">
                                            <Setter TargetName="PinGlyph" Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel x:Name="EmptyState"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <Path Width="36" Height="36"
                              HorizontalAlignment="Center"
                              Stretch="Uniform"
                              Stroke="{DynamicResource TextTertiary}"
                              StrokeThickness="1.2"
                              StrokeLineJoin="Round"
                              Opacity="0.7"
                              Data="M3,4 L3,13 A2,2 0 0 0 5,15 L13,15 A2,2 0 0 0 15,13 L15,4 A2,2 0 0 0 13,2 L5,2 A2,2 0 0 0 3,4 Z M3,6 L15,6 M7,2 L7,6" />
                        <TextBlock x:Name="EmptyTitle"
                                   Style="{StaticResource BaseText}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"
                                   Text="暂无剪贴板历史记录" />
                        <TextBlock x:Name="EmptyHint"
                                   Style="{StaticResource BaseText}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextTertiary}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,5,0,0"
                                   MaxWidth="300"
                                   TextWrapping="Wrap"
                                   Text="复制任意文本、图片或文件后，会出现在这里" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
