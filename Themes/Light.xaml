<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色主题（对齐 Win11 剪贴板面板观感） -->
    <SolidColorBrush x:Key="PanelBg"        Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelBorder"    Color="#E2E2E2" />

    <SolidColorBrush x:Key="CardBg"         Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardHoverBg"    Color="#F9F9F9" />
    <SolidColorBrush x:Key="CardBorder"     Color="#EDEDED" />
    <SolidColorBrush x:Key="CardBorderHover" Color="#C9C9C9" />
    <SolidColorBrush x:Key="CardFocusBorder" Color="#1B1B1B" />

    <SolidColorBrush x:Key="TextPrimary"    Color="#1B1B1B" />
    <SolidColorBrush x:Key="TextSecondary"  Color="#6E6E6E" />
    <SolidColorBrush x:Key="TextTertiary"   Color="#9A9A9A" />

    <SolidColorBrush x:Key="SearchBg"       Color="#FFFFFF" />
    <SolidColorBrush x:Key="SearchBorder"   Color="#E0E0E0" />
    <SolidColorBrush x:Key="SearchFocusBorder" Color="#0067C0" />

    <SolidColorBrush x:Key="Divider"        Color="#E4E4E4" />
    <SolidColorBrush x:Key="Accent"         Color="#0067C0" />
    <SolidColorBrush x:Key="AccentHover"    Color="#0B5FA8" />

    <SolidColorBrush x:Key="HoverOverlay"   Color="#14000000" />
    <SolidColorBrush x:Key="PressedOverlay" Color="#22000000" />
    <SolidColorBrush x:Key="MenuBg"         Color="#FBFBFB" />
    <SolidColorBrush x:Key="ScrollThumb"    Color="#C8C8C8" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#A8A8A8" />
    <SolidColorBrush x:Key="PinGlyph"       Color="#0067C0" />

</ResourceDictionary>