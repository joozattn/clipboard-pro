<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色主题 -->
    <SolidColorBrush x:Key="PanelBg"        Color="#202020" />
    <SolidColorBrush x:Key="PanelBorder"    Color="#3A3A3A" />

    <SolidColorBrush x:Key="CardBg"         Color="#2C2C2C" />
    <SolidColorBrush x:Key="CardHoverBg"    Color="#353535" />
    <SolidColorBrush x:Key="CardBorder"     Color="#3A3A3A" />
    <SolidColorBrush x:Key="CardBorderHover" Color="#4A4A4A" />
    <SolidColorBrush x:Key="CardFocusBorder" Color="#FFFFFF" />

    <SolidColorBrush x:Key="TextPrimary"    Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondary"  Color="#A8A8A8" />
    <SolidColorBrush x:Key="TextTertiary"   Color="#7A7A7A" />

    <SolidColorBrush x:Key="SearchBg"       Color="#2C2C2C" />
    <SolidColorBrush x:Key="SearchBorder"   Color="#3A3A3A" />
    <SolidColorBrush x:Key="SearchFocusBorder" Color="#4CC2FF" />

    <SolidColorBrush x:Key="Divider"        Color="#383838" />
    <SolidColorBrush x:Key="Accent"         Color="#4CC2FF" />
    <SolidColorBrush x:Key="AccentHover"    Color="#8FD6FF" />

    <SolidColorBrush x:Key="HoverOverlay"   Color="#18FFFFFF" />
    <SolidColorBrush x:Key="PressedOverlay" Color="#28FFFFFF" />
    <SolidColorBrush x:Key="MenuBg"         Color="#2B2B2B" />
    <SolidColorBrush x:Key="ScrollThumb"    Color="#4A4A4A" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#5E5E5E" />
    <SolidColorBrush x:Key="PinGlyph"       Color="#4CC2FF" />

</ResourceDictionary>